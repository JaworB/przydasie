# Template for /etc/msmtprc on lorien — used by scripts/bash/lorien_log_report.sh
# to email the daily log report. Copy to /etc/msmtprc (mode 600, root:root),
# fill in the real app password, and never commit the real file.
#
# The password must be a Google App Password (requires 2-Step Verification):
# https://myaccount.google.com/apppasswords

defaults
auth           on
tls            on
tls_trust_file /etc/pki/tls/certs/ca-bundle.crt
logfile        /var/log/msmtp.log

account        gmail
host           smtp.gmail.com
port           587
from           bjawornicki@gmail.com
user           bjawornicki@gmail.com
password       CHANGE_ME_APP_PASSWORD

account default : gmail
