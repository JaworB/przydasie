scanLibraries = function(router)
    metax = include_lib("/lib/metaxploit.so")
    if metax == null then exit("Metaxploit library could not be loaded!")
    ports = portList(router)
    libKeys = []
    for port in ports
        dumpLib = metax.net_use(ipAddress, port.port_number).dump_lib
        libName = dumpLib.lib_name
        libVersion = dumpLib.version
        libKey = libName + " " + libVersion
        if libKeys.indexOf(libKey) == null then libKeys.push(libKey)
    end for
    print(libKeys)
