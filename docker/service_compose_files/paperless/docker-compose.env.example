# Paperless-ngx environment
# Copy this file to docker-compose.env and fill in the values
# Shared with the db service too (env_file:), since Postgres also reads
# POSTGRES_* from it — keeps every credential out of the tracked yaml.

PAPERLESS_URL=https://paperless.jawor.org
PAPERLESS_SECRET_KEY=change-me
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=change-me
PAPERLESS_TIME_ZONE=Europe/Warsaw
PAPERLESS_OCR_LANGUAGE=eng+pol

POSTGRES_DB=paperless
POSTGRES_USER=paperless
POSTGRES_PASSWORD=change-me
